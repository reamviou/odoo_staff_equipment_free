<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vitouequ_equipment_list" model="ir.ui.view">
        <field name="name">vitouequ.equipment.list</field>
        <field name="model">vitouequ.equipment</field>
        <field name="arch" type="xml">
            <list default_order="name asc">
                <header>
                    <button name="%(action_vitouequ_open_report_equipment_view)d" type="action" class="btn-success"
                            string="Print" display="always"
                            help="Print Equipment List"/>
                </header>

                <!--                 <field name="id" />-->

                <field name="name"/>
                <field name="equipment_no"/>
                <field name="cost"/>
                <field name="date_buy"/>
                <field name="date_use"/>
                <field name="location_use_id"/>
                <field name="model"/>
                <field name="serial"/>
                <field name="location_use_name" optional="hide"/>
                <field name="state"
                       widget="label_selection"
                       options="{'classes': {'posted': 'success','done': 'danger'}}"
                />

                <field name="image" widget="image" options="{'size': [40, 40]}"/>


                <field name="employee_id"/>
                <field name="position"/>
                <field name="department"/>
                <field name="company_id"/>

                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="write_date" optional="show"/>
                <field name="write_uid" optional="show"/>
                <field name="done_date" optional="hide"/>
                <field name="done_uid" optional="hide"/>
                <field name="undodone_date" optional="hide"/>
                <field name="undodone_uid" optional="hide"/>
            </list>

        </field>
    </record>


    <record id="view_vitouequ_equipment_form" model="ir.ui.view">
        <field name="name">vitouequ.equipment.form</field>
        <field name="model">vitouequ.equipment</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="action_done" type="object" string="Done" invisible="state!='posted'"
                            class="btn-success  ml4"/>

                    <button name="action_undo_done" type="object" string="Undo Done" class="btn-danger  ml4"
                            invisible="state!='done'"
                            confirm="Undo from Done?"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="posted, done"/>
                </header>

                <sheet>
                    <group>


                        <group>

                            <!--                            <field name="id"/>-->

                            <field name="name" readonly="state!='posted'"/>
                            <field name="image" readonly="state!='posted'" widget="image"
                                   options="{'size': [60, 60]}"/>
                            <field name="model" readonly="state!='posted'"/>
                            <field name="serial" readonly="state!='posted'"/>
                            <field name="cost" readonly="state!='posted'"/>
                            <field name="date_buy" readonly="state!='posted'"/>

                            <field name="note" readonly="state!='posted'"/>
                            <field name="equipment_no" invisible="1"/>

                        </group>
                        <group string="Transfer">


                            <field name="location_use_id"/>
                            <div>
                                <label for='equipment_no' class="oe_inline"/>
                                <field name="equipment_no" class="oe_inline ps-2" style="width:200px !important;"
                                       readonly="1"/>
                                <button name="action_update_equipment_no" type="object" string="Get"
                                        icon="fa-arrow-left" class="btn-primary oe_inline rounded-pill btn-sm"/>
                            </div>
                            <field name="date_use"/>
                            <field name="employee_id"/>
                            <field name="company_id"/>

                            <field name="position" invisible="1"/>
                            <field name="department" invisible="1"/>

                            <button name="action_transfer" icon="fa-floppy-o" string="Transfer" type="object"
                                    class="btn-success rounded-pill" confirm="Save Transfer?"/>


                        </group>

                    </group>


                    <notebook>
                        <page string="History">
                            <field name="line_ids">
                                <list create="0" edit="0" delete="0" default_order="id desc" no_open="1" limit="5">
                                    <field name="id" readonly="1"/>
                                    <field name="equipment_id" optional="hide" readonly="1"/>
                                    <field name="equipment_no" optional="hide" readonly="1"/>
                                    <field name="name" optional="hide" readonly="1"/>
                                    <field name="model" optional="hide" readonly="1"/>
                                    <field name="serial" optional="hide" readonly="1"/>
                                    <field name="cost" optional="hide" readonly="1"/>
                                    <field name="date_buy" optional="hide" readonly="1"/>
                                    <field name="state" optional="hide" readonly="1"/>

                                    <field name="employee_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="date_use" readonly="1"/>
                                    <field name="location_use_id" readonly="1"
                                           options="{'no_open': True, 'no_create': True}"/>
                                    <field name="status" widget="label_selection"
                                           options="{'classes':{'posted':'success','confirmed':'danger'}}"
                                           readonly="1"/>

                                    <button name="action_unconfirmed" invisible="status != 'confirmed'"
                                            help="Undo Confirmed" icon="fa-reply" confirm="Undo Confirmed?"
                                            title="Undo Confirm"
                                            type="object" class="btn-warning"/>

                                    <button name="action_confirmed" invisible="status != 'posted'"
                                            help="Confirm for lock delete" icon="fa-check-circle" type="object"
                                            title="Confirm"
                                            class="btn-info"/>

                                    <button name="unlink" type="object" invisible="status != 'posted'"
                                            confirm="Delete this record?" help="Delete Record" icon="fa-trash"
                                            class="btn-danger" title="Unlink"
                                            
                                    />

                                    <field name="company_id" optional="hide"/>
                                    <field name="create_uid" optional="hide"/>
                                    <field name="create_date" optional="hide"/>
                                    <field name="write_uid" optional="hide"/>
                                    <field name="write_date" optional="hide"/>

                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>


                <!--                <chatter/>-->

                <!--                <div class="oe_chatter">-->
                <!--                    <field name="message_follower_ids" groups="base.group_user"/>-->
                <!--                    <field name="message_ids"/>-->

                <!--                </div>-->
            </form>

        </field>
    </record>

    <record id="view_vitouequ_equipment_search" model="ir.ui.view">

        <field name="name">vitouequ.equipment.search</field>
        <field name="model">vitouequ.equipment</field>

        <field name="arch" type="xml">

            <search>
                <field name="name"/>
                <field name="state"/>
                <field name="equipment_no"/>
                <field name="date_buy"/>
                <field name="date_use"/>
                <!--                <field name="location_use_id"/>-->


                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="filter_done" string="Done" domain="[('state','=','done')]"/>


                <searchpanel>

                    <field name="state" icon="fa-filter" enable_counters="1"/>
                    <field name="location_use_id" icon="fa-filter" enable_counters="1"/>
                     <field name="company_id" icon="fa-filter" enable_counters="1"/>

                    <field name="employee_id" icon="fa-filter" enable_counters="1"/>

                </searchpanel>

            </search>

        </field>
    </record>


    <record id="action_vitouequ_equipment" model="ir.actions.act_window">
        <field name="name">Equipment List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vitouequ.equipment</field>
        <field name="view_mode">list,form</field>
        <!--         <field name="context">{'search_default_filter_posted_approved':1}</field>-->
        <!--        <field name="view_ids"-->
        <!--               eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_vitouequ_equipment_list')}),-->
        <!--                                  (0, 0, {'view_mode': 'form', 'view_id': ref('view_vitouequ_equipment_form')}),-->
        <!--                                  ]"/>-->

        <!--        (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_vitouslot_dailypayout_cage_kanban')}),-->
    </record>


</odoo>